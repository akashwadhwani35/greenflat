PORT=5000
DATABASE_URL=postgresql://username:password@localhost:5432/ai_dating_app
JWT_SECRET=your_jwt_secret_key_here_change_in_production
JWT_EXPIRES_IN=7d
NODE_ENV=development
REQUIRE_EXTERNAL_SERVICES=true

# CORS (comma-separated origins; omit to allow all in development)
# CORS_ALLOWED_ORIGINS=https://myapp.example.com,https://admin.example.com

# OpenAI Configuration (Required for AI matching)
# Get from: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-openai-api-key-here
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Google OAuth (Required for "Continue with Google")
# Add every client ID that can issue ID tokens for your app (comma-separated)
# Example: android-client-id,ios-client-id,web-client-id
# GOOGLE_OAUTH_CLIENT_IDS=your-android.apps.googleusercontent.com,your-ios.apps.googleusercontent.com,your-web.apps.googleusercontent.com
# Optional single-ID fallback:
# GOOGLE_OAUTH_CLIENT_ID=your-web.apps.googleusercontent.com

# Google Maps API (Required for location verification)
# Get from: https://console.cloud.google.com/ → APIs & Services → Credentials
# Enable: Geocoding API, Places API
GOOGLE_MAPS_API_KEY=your-google-maps-api-key-here

# Expo Push Notifications (No API key needed)
# Uses your Expo account (npx expo login)
# App automatically registers push tokens

# SMS OTP (Required for phone verification)
# Twilio: https://console.twilio.com/
# TWILIO_ACCOUNT_SID=your-account-sid
# TWILIO_AUTH_TOKEN=your-auth-token
# TWILIO_FROM_NUMBER=+1234567890
# ALLOW_DEV_OTP_BYPASS=true

# Support Contact (Optional - send support form submissions to email)
# Resend: https://resend.com/
# RESEND_API_KEY=re_xxxxxxxxx
# SUPPORT_EMAIL=support@greenflag.app
# SUPPORT_FROM_EMAIL=GreenFlag <no-reply@greenflag.app>

# Media Upload (Required for chat image/voice in production)
# Cloudinary: https://console.cloudinary.com/
# CLOUDINARY_CLOUD_NAME=your-cloud-name
# CLOUDINARY_API_KEY=your-api-key
# CLOUDINARY_API_SECRET=your-api-secret
# MEDIA_UPLOAD_FOLDER=greenflag/messages
# MEDIA_ALLOWED_HOSTS=res.cloudinary.com
# MEDIA_LOCAL_UPLOADS=true
# MEDIA_LOCAL_DIR=uploads/messages
# MEDIA_LOCAL_MAX_BYTES=8388608

# Photo Storage (Optional - for production)
# AWS S3: https://aws.amazon.com/s3/
# AWS_ACCESS_KEY_ID=your-access-key
# AWS_SECRET_ACCESS_KEY=your-secret-key
# S3_BUCKET=your-bucket-name
# AWS_REGION=us-east-1

# Migrations
# Pending migrations run before the server accepts traffic. The runner takes a
# Postgres advisory lock, so several instances booting at once is safe. Set to
# false to run `npm run migrate` as a separate deploy step instead.
# RUN_MIGRATIONS_ON_BOOT=true

# Free token allowance
# Tops a user's balance UP TO this floor once per interval (it does not add, so
# tokens cannot be stockpiled). Required while payments are off: without it a
# user spends their signup balance and is permanently locked out of AI search,
# superlikes, compliments and boost. Also caps per-user OpenAI spend, since
# every AI search is a real model call. Set to 0 to disable.
# FREE_TOKEN_ALLOWANCE=30
# TOKEN_ALLOWANCE_INTERVAL_HOURS=24

# RevenueCat (in-app purchases)
# The client buys through the RevenueCat SDK; the server then asks RevenueCat
# what this user actually owns before granting anything. Set the secret key to
# register the receipt validator. Product ids live in
# src/services/products.catalog.ts and must match App Store Connect and Play
# Console exactly.
# REVENUECAT_SECRET_KEY=sk_xxxxxxxx
# Shared secret you set on the webhook in the RevenueCat dashboard. Required for
# renewals, cancellations and expiries to reach us; without it subscriptions
# never actually end.
# REVENUECAT_WEBHOOK_AUTH=some-long-random-string
# Allow sandbox purchases to grant goods in production. Leave off.
# REVENUECAT_ALLOW_SANDBOX=false

# Payments
# Off by default. Token packs and subscriptions return 501 until BOTH:
#   1. a receipt validator is registered (src/services/payments.service.ts), and
#   2. PAYMENTS_ENABLED=true
# Both are required so flipping this variable alone cannot reopen the hole where
# any authenticated user could mint tokens for free.
#
# Stripe cannot be used for in-app digital goods: Apple and Google require their
# own billing. This needs StoreKit / Play Billing, directly or via RevenueCat,
# with server-side receipt validation.
# PAYMENTS_ENABLED=false

# Media storage (Google Cloud Storage)
# Replaces Cloudinary: same project, same billing, no extra vendor. The bucket is
# private (an org policy blocks public objects, and dating-app photos should not
# be publicly enumerable), so uploads are served back through GET /api/media/:name.
# Unset locally means profile photo upload returns 503 rather than storing.
# GCS_MEDIA_BUCKET=greenflag-app-media
# MEDIA_MAX_UPLOAD_BYTES=8388608

# Verification code delivery by email (free tier: 3,000/month at resend.com)
# The onboarding screen lets a user verify by email or phone. Email needs no
# carrier registration, so it is the default path; SMS still needs Twilio.
# RESEND_API_KEY is shared with the support contact form above.
# OTP_FROM_EMAIL=GreenFlag <verify@gflag.app>
