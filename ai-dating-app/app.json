{
  "expo": {
    "name": "Greenflag",
    "slug": "greenflag",
    "scheme": [
      "greenflag",
      "app.gflag.greenflag"
    ],
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": false,
    "owner": "akashwadhwani",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#101D13"
    },
    "ios": {
      "supportsTablet": false,
      "usesAppleSignIn": true,
      "entitlements": {
        "aps-environment": "production"
      },
      "bundleIdentifier": "app.gflag.greenflag",
      "buildNumber": "7",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "GreenFlag needs your location to suggest nearby matches and verify your city.",
        "NSCameraUsageDescription": "GreenFlag needs camera access to take profile photos.",
        "NSPhotoLibraryUsageDescription": "GreenFlag needs photo library access to select profile photos.",
        "NSMicrophoneUsageDescription": "GreenFlag needs the microphone to record voice notes in chat.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "app.gflag.greenflag",
      "googleServicesFile": "./google-services.json",
      "versionCode": 3,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ADFF1A"
      },
      "edgeToEdgeEnabled": true,
      "allowBackup": false,
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "CAMERA",
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE",
        "POST_NOTIFICATIONS"
      ]
    },
    "plugins": [
      "expo-apple-authentication",
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#3BB273",
          "defaultChannel": "default"
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "GreenFlag needs your location to suggest nearby matches."
        }
      ],
      [
        "@react-native-google-signin/google-signin",
        {
          "iosUrlScheme": "com.googleusercontent.apps.480247350372-v7ka79dqp9n4t0sfbvba9k3o2uqeunlj"
        }
      ]
    ],
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "description": "An empathic, AI-guided dating experience focused on meaningful green flags.",
    "extra": {
      "eas": {
        "projectId": "ed5ee7ff-6a2b-4105-8b4c-f727e1021b44"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/ed5ee7ff-6a2b-4105-8b4c-f727e1021b44"
    }
  }
}
